# Files excluded from the distributed plugin package (git archive export).
#
# The wordpress.org zip is built with `git archive` (see CLAUDE.md), so
# anything marked here is tracked in git but never reaches a user's site.
# The test harness lives entirely behind this line: adding or changing a test
# produces a byte-identical distributable and needs no plugin release.
/.gitattributes export-ignore
/.gitignore     export-ignore
/.mailmap       export-ignore
/CLAUDE.md      export-ignore
/composer.json  export-ignore
/composer.lock  export-ignore
/phpunit.xml    export-ignore
/tests          export-ignore
